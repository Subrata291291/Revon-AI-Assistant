# ============================================================================
# LLM Provider Fallback Router Configuration
# Priority: Groq (Primary) -> OpenRouter (1st Fallback) -> Gemini (2nd Fallback) -> OpenAI (Final Fallback)
# ============================================================================
LLM_PROVIDER_PRIORITY=groq,openrouter,gemini,openai
LLM_REQUEST_TIMEOUT=30.0

# 1. Primary: Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# 2. First Fallback: OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# 3. Second Fallback: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# 4. Final Fallback: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ============================================================================
# Vector Store & Embedding Configuration
# ============================================================================
PINECONE_API_KEY=
PINECONE_INDEX_NAME=revon-policy-index
PINECONE_INDEX_HOST=revon-policy-index-v3nl0yu.svc.aped-4627-b74a.pinecone.io

# Gemini embedding configuration
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# ============================================================================
# Security & Rate Limiting Tokens
# ============================================================================
REVON_ADMIN_TOKEN=
REVON_CHAT_TOKEN=
CHAT_RATE_LIMIT_PER_MINUTE=10
